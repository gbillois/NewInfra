{
  // NewsRadar — Worker unique : API + assets statiques.
  "name": "newsradar",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Le worker passe en premier pour appliquer l'auth cookie avant de
    // servir les pages statiques.
    "run_worker_first": true
  },
  "ai": { "binding": "AI" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "newsradar-db",
      // Placeholder : le workflow deploy.yml crée la base si besoin et
      // remplace cet UUID par le vrai id avant migrations + deploy.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "observability": { "enabled": true }
}
